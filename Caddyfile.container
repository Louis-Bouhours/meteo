:80 {
    root * /srv
    encode zstd gzip
    file_server
    try_files {path} /index.html

    @static {
        path *.js *.css *.svg *.png *.jpg *.jpeg *.gif *.webp *.ico *.txt *.json *.wasm
    }
    header @static Cache-Control "public, max-age=31536000, immutable"
    header /index.html Cache-Control "no-store"
}